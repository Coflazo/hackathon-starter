# Main model (the sponsor's, if a prize requires it). OpenAI-compatible endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional fallback, for example a local free-tier router.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# 1 = answer only from fixtures/ (judging, bad Wi-Fi). RECORD=1 saves live answers as fixtures.
DEMO_MODE=0
RECORD=0
# Requests per minute per IP on /api/demo (keeps a public demo from draining the quota).
DEMO_RATE_LIMIT=20
